############
# Several Divergence and metric functions
#############
#Aitchinson Distance
#####
aitchison_distance <- function(x, y) {
D <- length(x)  # Dimension of compositions
distances <- numeric()  # To store individual distances
for (i in 1:(D - 1)) {
for (j in (i + 1):D) {
dist_ij <- log(x[i]/y[i]) - log(x[j]/y[j])
distances <- c(distances, dist_ij^2)
}
}
aitchison_dist <- sqrt((1/D) * sum(distances))
return(aitchison_dist)
}
CKL_distance <- function(x, y) {
D <- length(x)  # Dimension of compositions
sum_x_over_y <- sum(x/y)
sum_y_over_x <- sum(y/x)
CKL_dist <- sqrt((D/2) * log((1/(D^2)) * sum_x_over_y * sum_y_over_x))
return(CKL_dist)
}
KD_divergence <- function(p, q) {
log_kappa <- function(p) {
return(0.5 * (p - 1/p))
}
A <- function(u) {
return(2*u^2 / (1 + u^2))
}
divergence <- (sum((log_kappa(p) - log_kappa(q)) * (A(p) / sum(A(p)))))
return(divergence)
}
#####
# Angular Distance
Angular_dis <- function(x, y) {
# Calculate cosine similarity
cos_sim <- sum(x * y) / (sqrt(sum(x^2)) * sqrt(sum(y^2)))
# Calculate the angle in radians
angle_radians <- acos(cos_sim)
return(angle_radians)
}
#####
# Hellinger Distance
Hellinger_distance <- function(x, y) {
# Calculate the square root of the components
sqrt_x <- sqrt(x)
sqrt_y <- sqrt(y)
# Calculate the squared differences between the square roots
squared_diff <- (sqrt_x - sqrt_y)^2
# Calculate the sum of squared differences and take the square root
sqrt_Hellinger_distance <- sqrt(sum(squared_diff))
return(sqrt_Hellinger_distance)
}
