############
# Several Divergence and metric functions
#############
#Aitchinson Distance
#####
aitchison <- function(x, y) {
D <- length(x)  # Dimension of compositions
distances <- numeric()  # To store individual distances
for (i in 1:(D - 1)) {
for (j in (i + 1):D) {
dist_ij <- log(x[i]/y[i]) - log(x[j]/y[j])
distances <- c(distances, dist_ij^2)
}
}
aitchison_dist <- sqrt((1/D) * sum(distances))
return(aitchison_dist)
}
#####
#Compositional KL Divergence
#####
CKL <- function(x, y) {
D <- length(x)  # Dimension of compositions
sum_x_over_y <- sum(x/y)
sum_y_over_x <- sum(y/x)
CKL_dist <- sqrt((D/2) * log((1/(D^2)) * sum_x_over_y * sum_y_over_x))
return(CKL_dist)
}
#####
# Kaniadakis Divergence
#####
KD <- function(p, q) {
log_kappa <- function(p) {
return(0.5 * (p - 1/p))
}
A <- function(u) {
return(2*u^2 / (1 + u^2))
}
divergence <- (sum((log_kappa(p) - log_kappa(q)) * (A(p) / sum(A(p)))))
return(divergence)
}
#####
# Angular Distance
angular <- function(x, y) {
# Calculate cosine similarity
cos_sim <- sum(x * y) / (sqrt(sum(x^2)) * sqrt(sum(y^2)))
# Calculate the angle in radians
angle_radians <- acos(cos_sim)
return(angle_radians)
}
#####
# Hellinger Distance
hellinger <- function(x, y) {
# Calculate the square root of the components
sqrt_x <- sqrt(x)
sqrt_y <- sqrt(y)
# Calculate the squared differences between the square roots
squared_diff <- (sqrt_x - sqrt_y)^2
# Calculate the sum of squared differences and take the square root
sqrt_Hellinger_distance <- sqrt(sum(squared_diff))
return(sqrt_Hellinger_distance)
}
#####
# J Divergence
j_divergence <- function(x, y) {
log_x <- log(x)
log_y <- log(y)
js_divergence <- sqrt(sum((log_x - log_y) * (x - y)))
return(js_divergence)
}
# Function to perform K-means clustering for compositional data
kmeans_compositional <- function(data, K, distance_function = "aitchison", max_iter = 100, tol = 1e-6) {
# Number of samples and dimensions
n <- nrow(data)
d <- ncol(data)
# Initialize cluster centroids randomly
centroids <- matrix(runif(K * d), nrow = K, ncol = d)
# Main loop
for (iter in 1:max_iter) {
# Assign each data point to the nearest centroid
distances <- matrix(NA, nrow = n, ncol = K)
for (k in 1:K) {
for (i in 1:n) {
if (distance_function == "aitchison") {
distances[i, k] <- aitchison_distance(data[i, ], centroids[k, ])
} else if (distance_function == "CKL") {
distances[i, k] <- CKL_distance(data[i, ], centroids[k, ])
} else if (distance_function == "KD") {
distances[i, k] <- KD_divergence(data[i, ], centroids[k, ])
} else if (distance_function == "angular") {
distances[i, k] <- Angular_dis(data[i, ], centroids[k, ])
} else if (distance_function == "hellinger") {
distances[i, k] <- Hellinger_distance(data[i, ], centroids[k, ])
} else if (distance_function == "j_divergence") {
distances[i, k] <- j_divergence(data[i, ], centroids[k, ])
} else {
stop("Unknown distance function")
}
}
}
clusters <- apply(distances, 1, which.min)
# Update centroids
new_centroids <- matrix(0, nrow = K, ncol = d)
for (k in 1:K) {
if (sum(clusters == k) > 0) {
new_centroids[k, ] <- colMeans(data[clusters == k, ])
} else {
new_centroids[k, ] <- centroids[k, ]  # Keep the centroid unchanged if no points assigned to it
}
}
# Check for convergence
if (sum(rowSums((centroids - new_centroids)^2)) < tol) {
break
}
# Update centroids
centroids <- new_centroids
}
# Return cluster assignments and centroids
return(list(cluster_assignments = clusters, centroids = centroids))
}
